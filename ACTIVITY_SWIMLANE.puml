' ==============================================================================
' DỰ ÁN: ANSERA LEARNING PLATFORM
' TÍNH NĂNG: GÓI HỌC THỬ 7 NGÀY (TRIAL 50% 3 BÀI ĐẦU & LIÊN KẾT THẺ THANH TOÁN)
' ĐẶC TẢ SƠ ĐỒ HOẠT ĐỘNG PHÂN LÀN (ACTIVITY SWIMLANE DIAGRAMS)
' TUÂN THỦ: BA-Kit Standard / rules/17-actor-role-definition.md
' ==============================================================================

' ==============================================================================
' 1. SƠ ĐỒ TỔNG THỂ END-TO-END SWIMLANE (E2E MASTER ACTIVITY FLOW)
' ==============================================================================
@startuml E2E_Master_Activity_Swimlane
skinparam style strictuml
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityBorderColor #2563EB
skinparam ActivityDiamondBackgroundColor #EFF6FF
skinparam ActivityDiamondBorderColor #1D4ED8

|#E0F2FE|Học viên / Khách vãng lai|
|#FEF3C7|Frontend Web App|
|#DCFCE7|Backend Platform Service|
|#FCE7F3|Cổng thanh toán quốc tế|
|#F3E8FF|Hệ thống Cron định kỳ|

|Học viên / Khách vãng lai|
start
:Truy cập trang Chi tiết khóa học;
if (Đã có tài khoản?) then (Chưa)
  |Frontend Web App|
  :Hiển thị Form Đăng ký tài khoản (US-AUTH-001);
  |Học viên / Khách vãng lai|
  :Nhập Username & Password hợp lệ;
  |Frontend Web App|
  :Validate client-side & Gửi yêu cầu đăng ký;
  |Backend Platform Service|
  :Tạo tài khoản & Cấp phiên JWT Token;
else (Đã đăng nhập)
endif

|Frontend Web App|
:Hiển thị giao diện Khóa học (US-CRS-002)
- Nhãn xanh 'Học thử 50%' cho Bài 1, 2, 3
- Icon Khóa 🔒 từ Bài 4 trở đi
- Nút CTA 'Trải nghiệm 7 ngày';

|Học viên / Khách vãng lai|
:Nhấn nút CTA 'Trải nghiệm 7 ngày';

|Frontend Web App|
:Bật Modal cam kết quyền lợi 7 ngày (US-ENR-003);

|Học viên / Khách vãng lai|
:Xem điều khoản & Nhấn 'Bắt đầu học thử';

|Frontend Web App|
:Hiển thị Form nhập thẻ quốc tế Visa/Mastercard (US-PAY-004);

|Học viên / Khách vãng lai|
:Nhập thông tin thẻ (Số thẻ, Hạn dùng, CVV, Tên);

|Frontend Web App|
:Kiểm tra thuật toán Luhn & Mã hóa dữ liệu;
:Gửi yêu cầu xác thực thẻ 0đ (Zero-Auth);

|Cổng thanh toán quốc tế|
:Thực hiện kiểm tra thẻ sống (Pre-authorization);
if (Thẻ hợp lệ & Được ngân hàng chấp thuận?) then (Có)
  :Tạo Payment Token bảo mật & Trả về thành công;
  |Backend Platform Service|
  :Lưu Payment Token vào ví tài khoản (PCI-DSS);
  :Kích hoạt gói học thử:
  - trial_status = ACTIVE
  - trial_end = Hiện tại + 7 ngày;
  |Frontend Web App|
  :Thông báo kích hoạt thành công;
  :Điều hướng vào Trình phát video Bài 1;
else (Từ chối / Lỗi)
  |Frontend Web App|
  :Báo lỗi MSG-004 (Thẻ bị từ chối);
  stop
endif

|Học viên / Khách vãng lai|
:Trải nghiệm video học thử (US-PLAY-005);
|Frontend Web App|
:Thiết lập mốc chặn tua Seek Guard = 50% thời lượng;
repeat
  :Phát video bài giảng;
  if (Học viên kéo tua quá 50%?) then (Có)
    :Seek Guard giật mốc thời gian về 50%;
  else (Không)
  endif
repeat while (Thời gian phát < 50% thời lượng?) is (Đúng)
->Đạt mốc 50%;

:Tự động TẠM DỪNG (Pause) video ngay lập tức;
:Kích hoạt Lớp phủ Paywall Modal MSG-005;

|Học viên / Khách vãng lai|
if (Quyết định sau khi xem 50%?) then (Xem bài thử khác)
  |Frontend Web App|
  :Mở Bài 2 hoặc Bài 3 (Tiếp tục áp dụng giới hạn 50%);
else (Mua toàn bộ khóa học)
  |Frontend Web App|
  :Mở màn hình Thanh toán mua đứt khóa học;
  stop
endif

|Hệ thống Cron định kỳ|
:Hết chu kỳ 7 ngày học thử (US-EXP-006);
:Quét các tài khoản có trial_end <= Thời điểm hiện tại;
|Backend Platform Service|
:Gọi Cổng thanh toán trừ tiền gia hạn tự động;
|Cổng thanh toán quốc tế|
if (Trừ tiền thành công?) then (Thành công)
  |Backend Platform Service|
  :Chuyển trạng thái: ENROLLED_FULL;
  :Mở khóa vĩnh viễn 100% toàn bộ bài học;
  stop
else (Thất bại / Đã hủy dùng thử)
  |Backend Platform Service|
  :Chuyển trạng thái: trial_status = EXPIRED;
  :Thu hồi toàn bộ quyền học thử (kể cả 3 bài đầu);
  |Frontend Web App|
  :Khóa toàn bộ giáo trình 🔒;
  :Hiển thị Banner cảnh báo hết hạn MSG-006;
  :Chặn toàn bộ Deep-link vào URL video;
  stop
endif
@enduml

' ==============================================================================
' 2. CHI TIẾT SWIMLANE TỪNG USER STORY
' ==============================================================================

' ------------------------------------------------------------------------------
' US-AUTH-001: Đăng ký tài khoản học viên mới
' ------------------------------------------------------------------------------
@startuml US_AUTH_001_Swimlane
skinparam style strictuml
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12

|#E0F2FE|Học viên (Khách)|
|#FEF3C7|Frontend UI|
|#DCFCE7|Backend Auth Service|
|#F1F5F9|Database|

|Học viên (Khách)|
start
:Nhấp nút 'Đăng ký' trên Header;
|Frontend UI|
:Hiển thị Form Đăng ký (SCR-AUTH-02);

|Học viên (Khách)|
repeat
  :Nhập Username, Mật khẩu, Xác nhận mật khẩu;
  :Nhấp nút 'Tạo tài khoản';
  |Frontend UI|
  :Kiểm tra Validation Client-side;
  if (Dữ liệu rỗng hoặc sai Regex?) then (Lỗi)
    :Hiển thị thông báo lỗi inline (MSG-001, MSG-002, MSG-003);
    |Học viên (Khách)|
  else (Hợp lệ)
    |Frontend UI|
    :Disable nút submit & Hiển thị Spinner;
    :Gửi POST /api/auth/register;
    |Backend Auth Service|
    :Truy vấn kiểm tra Username trùng lặp;
    |Database|
    :Query users table;
    |Backend Auth Service|
    if (Username đã tồn tại?) then (Trùng lặp)
      |Frontend UI|
      :Hiển thị lỗi 409 Conflict MSG-001;
      :Mở lại nút bấm để học viên sửa tên;
      |Học viên (Khách)|
    else (Chưa tồn tại)
      |Backend Auth Service|
      :Mã hóa mật khẩu bằng thuật toán Bcrypt;
      :Ghi bản ghi học viên mới vào DB;
      |Database|
      :Insert into users;
      |Backend Auth Service|
      :Sinh JWT Token & Thiết lập phiên đăng nhập;
      |Frontend UI|
      :Lưu JWT vào Storage an toàn;
      :Tự động chuyển hướng về trang trước đó;
      |Học viên (Khách)|
      :Trở thành Học viên đã định danh;
      stop
    endif
  endif
repeat while (Đăng ký chưa thành công)
@enduml

' ------------------------------------------------------------------------------
' US-CRS-002: Xem chi tiết khóa học & Nhận diện bài học thử
' ------------------------------------------------------------------------------
@startuml US_CRS_002_Swimlane
skinparam style strictuml
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12

|#E0F2FE|Học viên|
|#FEF3C7|Frontend Course UI|
|#DCFCE7|Backend Course Service|
|#F1F5F9|Database / CDN|

|Học viên|
start
:Truy cập đường dẫn khóa học /courses/:slug;
|Frontend Course UI|
:Gửi GET /api/courses/:slug/detail;
|Backend Course Service|
:Xác định thông tin khóa học & trạng thái Enrollment của User;
|Database / CDN|
:Query course, modules, lessons, user_trials;
|Backend Course Service|
:Trả về Payload khóa học kèm Trial Policy:
- Bài 1, 2, 3: is_trial_eligible = true
- Bài 4+: is_locked = true;

|Frontend Course UI|
:Render giao diện Chi tiết khóa học:
- Gắn Huy hiệu xanh 'Học thử 50%' cho 3 bài đầu
- Gắn Biểu tượng Khóa 🔒 cho các bài còn lại
- Hiển thị Sidebar với CTA 'Trải nghiệm 7 ngày';

|Học viên|
:Xem cấu trúc giáo trình & giảng viên;
if (Học viên muốn trải nghiệm?) then (Bấm CTA 'Trải nghiệm 7 ngày')
  |Frontend Course UI|
  :Kích hoạt sự kiện mở Modal cam kết (US-ENR-003);
  stop
else (Bấm xem thử Bài 1 trực tiếp)
  |Frontend Course UI|
  :Nhận diện chưa kích hoạt gói học thử;
  :Tự động kích hoạt mở Modal cam kết (US-ENR-003);
  stop
endif
@enduml

' ------------------------------------------------------------------------------
' US-ENR-003: Đăng ký trải nghiệm học thử 7 ngày (Modal cam kết)
' ------------------------------------------------------------------------------
@startuml US_ENR_003_Swimlane
skinparam style strictuml
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12

|#E0F2FE|Học viên|
|#FEF3C7|Frontend Modal UI|
|#DCFCE7|Backend Trial Service|

|Học viên|
start
:Kích hoạt quy trình trải nghiệm;
|Frontend Modal UI|
:Hiển thị MODAL-ENR-01 phủ mờ màn hình:
1. Quyền xem 50% thời lượng của 3 bài giảng đầu
2. Chi phí hôm nay: 0 VNĐ (Miễn phí 7 ngày)
3. Ràng buộc: Cần thẻ thanh toán quốc tế & tự gia hạn sau 7 ngày;

|Học viên|
if (Quyết định của học viên?) then (Bấm 'Để sau' hoặc nút 'X')
  |Frontend Modal UI|
  :Đóng modal & Giữ nguyên màn hình chi tiết khóa học;
  stop
else (Bấm 'Bắt đầu dùng thử')
  |Frontend Modal UI|
  :Kiểm tra thông tin thanh toán đã lưu của User;
  |Backend Trial Service|
  if (Tài khoản đã có thẻ liên kết hợp lệ?) then (Đã có thẻ)
    :Tự động tạo bản ghi học thử (trial_status = ACTIVE);
    |Frontend Modal UI|
    :Điều hướng thẳng vào Trình phát video (US-PLAY-005);
    stop
  else (Chưa có thẻ)
    |Frontend Modal UI|
    :Chuyển tiếp sang Màn hình liên kết thẻ (US-PAY-004);
    stop
  endif
endif
@enduml

' ------------------------------------------------------------------------------
' US-PAY-004: Xác thực & Liên kết thẻ thanh toán quốc tế
' ------------------------------------------------------------------------------
@startuml US_PAY_004_Swimlane
skinparam style strictuml
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12

|#E0F2FE|Học viên|
|#FEF3C7|Frontend Checkout UI|
|#DCFCE7|Backend Payment Service|
|#FCE7F3|Cổng thanh toán (Gateway)|
|#F1F5F9|Database|

|Học viên|
start
:Vào màn hình liên kết thẻ thanh toán;
|Frontend Checkout UI|
:Hiển thị Form Thẻ Quốc tế & Tóm tắt: Thanh toán hôm nay 0đ;

|Học viên|
repeat
  :Nhập Tên chủ thẻ, Số thẻ, Ngày hết hạn, CVV;
  :Bấm 'Xác thực thẻ & Kích hoạt';
  |Frontend Checkout UI|
  :Kiểm tra Validation Client:
  - Thuật toán Luhn cho số thẻ
  - Định dạng hạn dùng MM/YY
  - Mã bảo mật CVV (3 chữ số);
  if (Form không hợp lệ?) then (Lỗi cú pháp)
    :Hiển thị lỗi inline đỏ (MSG-001, MSG-002, MSG-003);
    |Học viên|
  else (Hợp lệ)
    |Frontend Checkout UI|
    :Khóa Form & Bật Spinner xác thực;
    :Gửi dữ liệu thẻ đã mã hóa sang Backend;
    |Backend Payment Service|
    :Gửi yêu cầu Zero-Auth (Pre-authorization) sang Gateway;
    |Cổng thanh toán (Gateway)|
    :Thực hiện bắt tay với Ngân hàng phát hành thẻ;
    if (Ngân hàng từ chối / Hết tiền / Khóa thẻ?) then (Decline)
      |Backend Payment Service|
      :Nhận mã lỗi Decline từ Gateway;
      |Frontend Checkout UI|
      :Hiển thị Alert đỏ thông báo thẻ bị từ chối (MSG-004);
      :Mở khóa lại Form để học viên đổi thẻ;
      |Học viên|
    else (Thẻ hợp lệ - Chấp thuận)
      |Cổng thanh toán (Gateway)|
      :Sinh Payment Token (chuẩn PCI-DSS);
      |Backend Payment Service|
      :Lưu Payment Token vào bảng payment_methods;
      :Tạo bản ghi dùng thử trong bảng enrollments:
      - trial_status = ACTIVE
      - trial_start = NOW()
      - trial_end = NOW() + 7 days
      - auto_renew = TRUE;
      |Database|
      :Insert / Update enrollments & payment_methods;
      |Frontend Checkout UI|
      :Hiển thị Toast xanh: 'Kích hoạt thành công gói học thử 7 ngày';
      :Điều hướng sang Trình phát video Bài 1 (US-PLAY-005);
      |Học viên|
      :Bắt đầu trải nghiệm học tập;
      stop
    endif
  endif
repeat while (Chưa kích hoạt thành công)
@enduml

' ------------------------------------------------------------------------------
' US-PLAY-005: Trình phát video 50% & Chặn tua Seek Guard
' ------------------------------------------------------------------------------
@startuml US_PLAY_005_Swimlane
skinparam style strictuml
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12

|#E0F2FE|Học viên|
|#FEF3C7|Player UI (Trình phát)|
|#BFDBFE|Seek Guard Controller|
|#DCFCE7|Streaming CDN / Video Server|

|Học viên|
start
:Mở bài học trong danh sách 3 bài đầu;
|Player UI (Trình phát)|
:Yêu cầu nạp tài nguyên bài giảng;
|Streaming CDN / Video Server|
:Cấp Manifest video & Metadata thời lượng (Duration);
|Player UI (Trình phát)|
|Seek Guard Controller|
:Tính toán: MaxAllowedTime = 50% * Duration;
|Player UI (Trình phát)|
:Vẽ thanh Seekbar:
- Nửa đầu hiển thị bình thường
- Nửa sau hiển thị vạch mờ kèm icon Khóa 🔒;

|Học viên|
:Bấm Play xem video;
|Player UI (Trình phát)|
repeat
  :Phát luồng video theo thời gian thực;
  |Học viên|
  if (Thao tác của học viên?) then (Xem liên tục)
    |Player UI (Trình phát)|
  else (Kéo tua / Click Seekbar)
    |Seek Guard Controller|
    if (Vị trí tua > MaxAllowedTime?) then (Vượt quá 50%)
      :CHẶN TUA!
      Cưỡng chế đưa current_time về MaxAllowedTime;
      |Player UI (Trình phát)|
      :Hiển thị cảnh báo chạm ngưỡng giới hạn;
    else (<= 50%)
      |Player UI (Trình phát)|
      :Cho phép nhảy tới mốc thời gian vừa chọn;
    endif
  endif
repeat while (current_time < MaxAllowedTime) is (Chưa đạt 50%)
->Đạt đúng 50% thời lượng;

|Seek Guard Controller|
:Phát tín hiệu KHÓA BÀI HỌC;
|Player UI (Trình phát)|
:Tự động thực hiện lệnh PAUSE video ngay lập tức;
:Bật Lớp phủ Paywall Modal (MSG-005) che toàn màn hình;

|Học viên|
if (Lựa chọn tại Modal Paywall?) then (Xem lại từ đầu)
  |Player UI (Trình phát)|
  :Reset video về giây 00:00 & Mở lại luồng phát;
  stop
else (Chuyển sang bài học thử kế tiếp)
  |Player UI (Trình phát)|
  :Chuyển sang Bài 2 hoặc Bài 3;
  stop
else (Nâng cấp toàn bộ khóa học)
  |Player UI (Trình phát)|
  :Điều hướng sang Màn hình Thanh toán mua đứt;
  stop
endif
@enduml

' ------------------------------------------------------------------------------
' US-EXP-006: Thu hồi quyền học thử sau 7 ngày khi không gia hạn
' ------------------------------------------------------------------------------
@startuml US_EXP_006_Swimlane
skinparam style strictuml
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12

|#F3E8FF|Hệ thống Cron Scheduler|
|#DCFCE7|Subscription Service|
|#FCE7F3|Cổng thanh toán|
|#F1F5F9|Database|
|#FEF3C7|Frontend UI|
|#E0F2FE|Học viên|

|Hệ thống Cron Scheduler|
start
:Kích hoạt Job quét định kỳ mỗi 15 phút;
:Tìm kiếm các bản ghi trial_status == 'ACTIVE' VÀ trial_end <= NOW();
|Subscription Service|
:Truy vấn danh sách học viên hết hạn dùng thử;
|Database|
:Select expired trial enrollments;
|Subscription Service|
repeat
  :Lấy thông tin Payment Token của học viên;
  if (Học viên đã chủ động HỦY gia hạn trước đó?) then (Đã hủy)
    :Đánh dấu hủy gia hạn;
  else (Vẫn duy trì tự động gia hạn)
    :Gửi lệnh trừ tiền tự động (Auto-charge) học phí trọn gói;
    |Cổng thanh toán|
    :Xử lý trừ tiền thẻ tín dụng/ghi nợ;
    if (Trừ tiền thành công?) then (Thành công)
      |Subscription Service|
      :Cập nhật enrollment: status = 'ENROLLED_FULL';
      |Database|
      :Mở khóa vĩnh viễn 100% toàn bộ khóa học;
      stop
    else (Thất bại / Hết hạn mức / Lỗi thẻ)
      |Subscription Service|
      :Ghi nhận trừ tiền không thành công;
    endif
  endif

  |Subscription Service|
  :THỰC HIỆN THU HỒI QUYỀN TRUY CẬP:
  - Cập nhật trial_status = 'EXPIRED'
  - Đặt access_revoked = TRUE;
  |Database|
  :Update enrollments set trial_status = 'EXPIRED';

  |Học viên|
  :Truy cập lại Khóa học hoặc Trình phát video;
  |Frontend UI|
  :Kiểm tra trạng thái Enrollment từ Backend;
  |Subscription Service|
  :Trả về trạng thái: EXPIRED (0% quyền truy cập);
  |Frontend UI|
  :Khóa toàn bộ các bài học trong Đề cương (kể cả Bài 1, 2, 3);
  :Hiển thị Banner cảnh báo đỏ MSG-006 trên trang chi tiết;
  if (Học viên cố tình dán link video cũ vào trình duyệt?) then (Deep-link)
    :Bộ lọc Middleware phát hiện trạng thái EXPIRED;
    :Chặn hiển thị video & Điều hướng về trang khóa học;
  else (Xem thông thường)
  endif
  :Nút CTA chính chuyển thành: 'Mua ngay để tiếp tục học';
repeat while (Còn bản ghi hết hạn cần xử lý)
stop
@enduml
